<?xml version="1.0"?>
<!-- UR5 + Robotiq 2F-85 (visual only). Root base_link = IKFast base frame; ee_link = IKFast end-effector frame (tool0 = ee_link rotated). Source: robowflex_resources ur5_robotiq_robot_limited.urdf.xacro, with the 0.9144 m pedestal offset removed and meshes converted to GLB. -->
<robot name="ur5_robotiq85">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="meshes/ur5/base.glb" />
      </geometry>
      <material name="LightGrey">
        <color rgba="0.7 0.7 0.7 1.0" />
      </material>
    </visual>
    <inertial>
      <mass value="4.0" />
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
      <inertia ixx="0.00443333156" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072" />
    </inertial>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link" />
    <child link="shoulder_link" />
    <origin rpy="0 0.0 0" xyz="0.0 0.0 0.089159" />
    <axis xyz="0 0 1" />
    <limit effort="150.0" lower="-3.14159265" upper="3.14159265" velocity="0.5" />
    <dynamics damping="0.0" friction="0.0" />
  </joint>
  <link name="shoulder_link">
    <visual>
      <geometry>
        <mesh filename="meshes/ur5/shoulder.glb" />
      </geometry>
